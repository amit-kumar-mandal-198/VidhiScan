# VidhiScan Backend Environment Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (Optional: defaults to local SQLite vidhiscan.db if unset)
# Example for PostgreSQL: postgresql://user:password@host:5432/vidhiscan
DATABASE_URL=sqlite:///./vidhiscan.db

# Server port (default: 8000)
PORT=8000
